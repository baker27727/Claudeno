{
  "//": "Lighthouse CI configuration — BLUEPRINT §6.2.5 (JS < 60KB) + §10 (Lighthouse ≥ 95)",
  "//": "Scope: homepage + learn index + learn/getting-started + quiz لكل لغة (EN + NO).",
  "//": "PWA غير مطلوب (مشروع ثابت بدون offline).",
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4321",
      "startServerReadyPattern": "Local\\s+(?:http|https)://127\\.0\\.0\\.1:4321",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "url": [
        "http://127.0.0.1:4321/en/",
        "http://127.0.0.1:4321/no/",
        "http://127.0.0.1:4321/en/learn/",
        "http://127.0.0.1:4321/no/learn/",
        "http://127.0.0.1:4321/en/learn/getting-started/",
        "http://127.0.0.1:4321/no/learn/getting-started/",
        "http://127.0.0.1:4321/en/quiz/",
        "http://127.0.0.1:4321/no/quiz/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "//pwa-skipped": "PWA غير مطلوب لموقع ثابت بدون offline (BLUEPRINT §10).",
        "categories:pwa": "off",
        "budgets:js-request-count": ["warn", { "maxNumericValue": 6 }],
        "budgets:total-byte-weight": ["warn", { "maxNumericValue": 250 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  },
  "budgets": [
    {
      "path": "/*\\.(js|mjs|cjs)$",
      "resourceSizes": [
        {
          "budget": 60
        }
      ]
    }
  ]
}