---
import Base from "../../../layouts/Base.astro";
import { LOCALES, useTranslations, formatDate, type Locale } from "../../../lib/i18n";
import { getAllBlogPosts, postForLocale } from "../../../lib/blog";
import { webPageJsonLd, breadcrumbListJsonLd, pageBreadcrumbs, jsonLdScript } from "../../../lib/seo";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

// كل منشورات المدونة، مرتّبة من الأحدث إلى الأقدم. المسودات (draft=true) لا تُعرض
// في الإنتاج لأنها غير جاهزة بعد للمراجعة البشرية (§9).
const allPosts = await getAllBlogPosts();
const isProd = import.meta.env.PROD;
const posts = allPosts
  .map((group) => ({ slug: group.slug, data: postForLocale(group, lang).data }))
  .filter(({ data }) => !(isProd && data.draft))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const pagePath = `/${lang}/blog/`;
const description = lang === "no"
  ? "Hva er nytt i Claude Code — og historien bak plattformen."
  : "What's new in Claude Code — and the story behind the platform.";
const webPage = webPageJsonLd({
  name: `${t("nav.blog")} — Claude Code Learn`,
  description,
  lang,
  path: pagePath,
});
const crumbs = breadcrumbListJsonLd(pageBreadcrumbs(t("nav.blog"), pagePath, lang));
const jsonLd = jsonLdScript([webPage, crumbs]);
---

<Base
  lang={lang}
  title={`${t("nav.blog")} — Claude Code Learn`}
  description={description}
>
  <Fragment slot="head">
    <Fragment set:html={jsonLd} />
  </Fragment>
  <main class="blog">
    <header class="blog__header">
      <p class="blog__eyebrow">{lang === "no" ? "Bloggen" : "The blog"}</p>
      <h1>{t("nav.blog")}</h1>
      <p class="blog__lede">
        {lang === "no"
          ? "Oppdateringer, dypdykk og hva som er nytt i Claude Code."
          : "Updates, deep-dives, and what's new in Claude Code."}
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="blog__empty">
        {lang === "no" ? "Ingen innlegg ennå." : "No posts yet."}
      </p>
    ) : (
      <ol class="blog__list">
        {posts.map(({ slug, data }) => (
          <li class="blog__card">
            <a class="blog__cardLink" href={`/${lang}/blog/${slug}/`}>
              <div class="blog__meta">
                <time datetime={data.pubDate}>
                  {formatDate(new Date(data.pubDate), lang)}
                </time>
                {data.draft && (
                  <span class="blog__draft">
                    {lang === "no" ? "Utkast" : "Draft"}
                  </span>
                )}
              </div>
              <h2 class="blog__title">{data.title}</h2>
              <p class="blog__excerpt">{data.description}</p>
              {data.tags.length > 0 && (
                <ul class="blog__tags">
                  {data.tags.map((tag) => (
                    <li class="blog__tag">{tag}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ol>
    )}
  </main>
</Base>

<style>
  .blog {
    max-width: 44rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-16);
  }
  .blog__header {
    margin-bottom: var(--space-10);
  }
  .blog__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .blog__header h1 {
    margin: 0 0 var(--space-3);
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
  .blog__lede {
    max-width: 32rem;
    color: var(--fg-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0;
  }
  .blog__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .blog__card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    transition: border-color 0.15s ease;
  }
  .blog__card:hover {
    border-color: var(--accent);
  }
  .blog__cardLink {
    display: block;
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
  }
  .blog__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }
  .blog__draft {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.6875rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-full);
    padding: 0.05rem 0.5rem;
  }
  .blog__title {
    font-size: 1.25rem;
    line-height: 1.3;
    margin: 0 0 var(--space-2);
    color: var(--fg);
  }
  .blog__excerpt {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .blog__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
  }
  .blog__tag {
    font-size: 0.75rem;
    color: var(--fg-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0.1rem 0.6rem;
  }
  .blog__empty {
    color: var(--fg-muted);
    font-style: italic;
  }
</style>