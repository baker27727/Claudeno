---
import Base from "../../../layouts/Base.astro";
import SkillCard from "../../../components/SkillCard.astro";
import { LOCALES, useTranslations, type Locale } from "../../../lib/i18n";
import {
  webPageJsonLd,
  breadcrumbListJsonLd,
  skillsIndexBreadcrumbs,
  jsonLdScript,
  SITE_URL,
  type JsonLdObject,
} from "../../../lib/seo";
import { getAllSkills, CATEGORY_LABELS, type SkillCategory } from "../../../lib/skills";

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const skills = await getAllSkills();

const pagePath = `/${lang}/skills/`;
const title = lang === "no"
  ? "Skills for Claude Code — utvid funksjonaliteten"
  : "Skills for Claude Code — extend what Claude can do";
const description = lang === "no"
  ? "Utforsk kuraterte Claude Code-skills: hva de gjør, hvordan installeres dem, og hvilke tillatelser de krever."
  : "Explore curated Claude Code skills: what they do, how to install them, and what permissions they require.";

const skillEntries = skills.map((skill, i) => ({
  "@type": "ListItem",
  position: i + 1,
  name: skill.meta.title[lang],
  url: `${SITE_URL}/${lang}/skills/${skill.slug}/`,
  description: skill.meta.summary[lang],
}));

const itemList: JsonLdObject = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: lang === "no" ? "Claude Code-skills" : "Claude Code Skills",
  inLanguage: lang,
  numberOfItems: skills.length,
  itemListElement: skillEntries,
};

const webPage = webPageJsonLd({
  name: title,
  description,
  lang,
  path: pagePath,
  mainEntity: { type: "ItemList", data: itemList },
});
const crumbs = breadcrumbListJsonLd(skillsIndexBreadcrumbs(lang));
const jsonLd = jsonLdScript([webPage, crumbs]);

// Only categories that contain at least one skill — empty ones have no page
// (see category/[category].astro), so linking them would create 404s.
const categories = (Object.keys(CATEGORY_LABELS) as SkillCategory[]).filter(
  (cat) => skills.some((s) => s.meta.categories.includes(cat)),
);
---

<Base lang={lang} title={title} description={description}>
  <Fragment slot="head">
    <Fragment set:html={jsonLd} />
  </Fragment>

  <main class="skills-index">
    <header class="skills-index__head">
      <p class="skills-index__eyebrow">{t("skills.eyebrow")}</p>
      <h1>{t("nav.skills")}</h1>
      <p class="skills-index__lede">{description}</p>
      <p class="skills-index__learn-hint">
        <a href={`/${lang}/learn/`}>{t("skills.learnHint")}</a>
      </p>
    </header>

    <section class="skills-index__categories" aria-labelledby="categories-heading">
      <h2 id="categories-heading" class="skills-index__section-title">{t("skills.allCategories")}</h2>
      <ul class="skills-index__category-list">
        {categories.map((cat) => (
          <li>
            <a class="skills-index__category" href={`/${lang}/skills/category/${cat}/`}>
              {CATEGORY_LABELS[cat][lang]}
            </a>
          </li>
        ))}
      </ul>
    </section>

    {categories.map((cat) => {
      const catSkills = skills.filter((s) => s.meta.categories.includes(cat));
      if (catSkills.length === 0) return null;
      return (
        <section class="skills-index__group" aria-labelledby={`cat-${cat}`}>
          <div class="skills-index__group-head">
            <h2 id={`cat-${cat}`}>{CATEGORY_LABELS[cat][lang]}</h2>
            <a href={`/${lang}/skills/category/${cat}/`} class="skills-index__see-all">
              {lang === "no" ? "Se alle" : "See all"} &rarr;
            </a>
          </div>
          <div class="skills-index__grid">
            {catSkills.map((skill) => (
              <SkillCard skill={skill} lang={lang} />
            ))}
          </div>
        </section>
      );
    })}
  </main>
</Base>

<style>
  .skills-index {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-16);
  }
  .skills-index__head {
    margin-bottom: var(--space-10);
  }
  .skills-index__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .skills-index__head h1 {
    margin: 0 0 var(--space-3);
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
  .skills-index__learn-hint {
    margin: var(--space-3) 0 0;
    font-size: 0.9375rem;
  }
  .skills-index__learn-hint a {
    color: var(--accent);
  }
  .skills-index__lede {
    margin: 0;
    color: var(--fg-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 44rem;
  }
  .skills-index__categories {
    margin-bottom: var(--space-10);
  }
  .skills-index__section-title {
    margin: 0 0 var(--space-4);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }
  .skills-index__category-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .skills-index__category {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    text-decoration: none;
    color: var(--fg);
    font-size: 0.9375rem;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .skills-index__category:hover {
    border-color: var(--accent);
    background: var(--bg-elev);
  }
  .skills-index__group {
    margin-bottom: var(--space-12);
  }
  .skills-index__group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .skills-index__group-head h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .skills-index__see-all {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .skills-index__see-all:hover {
    text-decoration: underline;
  }
  .skills-index__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-5);
  }
  @media (max-width: 560px) {
    .skills-index__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
