---
import ThemeToggle from "../islands/ThemeToggle.svelte";
import SearchPalette from "../islands/SearchPalette.svelte";
import { useTranslations, switchLocalePath, type Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
  /** Restrict which locales the language switcher may target — see Base.astro. */
  availableLocales?: Locale[];
}

const { lang, availableLocales = ["en", "no"] }: Props = Astro.props;
const t = useTranslations(lang);
const otherLocale = lang === "en" ? "no" : "en";
// If the current page isn't translated into otherLocale yet (e.g. a
// NO-only guide), don't link straight into a 404 — fall back to that
// locale's homepage instead.
const otherPath = availableLocales.includes(otherLocale)
  ? switchLocalePath(Astro.url.pathname, otherLocale)
  : `/${otherLocale}/`;

// Guider/Guides is deliberately kept out of the top nav — at common laptop
// widths (~1280px) a 9th item pushed the language switcher off-screen.
// Discoverable instead via the homepage, /learn/, and the footer.
//
// The remaining 8 were still too many words for one bar. Split into the
// core product surfaces (always visible) and secondary/meta pages (tucked
// into a "More" dropdown) — same idea, taken one step further.
const primaryLinks: Array<{ href: string; label: string }> = [
  { href: `/${lang}/learn/`, label: t("nav.learn") },
  { href: `/${lang}/playground/`, label: t("nav.playground") },
  { href: `/${lang}/build/`, label: t("nav.build") },
  { href: `/${lang}/reference/`, label: t("nav.reference") },
];
const secondaryLinks: Array<{ href: string; label: string }> = [
  { href: `/${lang}/quiz/`, label: t("nav.quiz") },
  { href: `/${lang}/blog/`, label: t("nav.blog") },
  { href: `/${lang}/changelog/`, label: t("nav.changelog") },
  { href: `/${lang}/feedback/`, label: t("nav.feedback") },
];
const links = [...primaryLinks, ...secondaryLinks];

const searchLabel = lang === "no" ? "Søk" : "Search";
---

<header class="site-nav">
  <div class="site-nav__inner">
    <a href={`/${lang}/`} class="site-nav__brand">
      <img src="/favicon.svg" alt="" width="24" height="24" />
      <span>Claude Code Learn</span>
    </a>
    <nav aria-label="Primary" class="site-nav__primary">
      <ul class="site-nav__links">
        {primaryLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <details class="site-nav__more">
        <summary>
          {t("nav.more")}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <ul class="site-nav__more-list">
          {secondaryLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </details>
    </nav>
    <div class="site-nav__actions">
      <SearchPalette client:idle locale={lang} showButton buttonLabel={searchLabel} />
      <a href={otherPath} class="site-nav__lang" rel="alternate" hreflang={lang === "en" ? "no" : "en"}>
        {t("lang.switch")}
      </a>
      <ThemeToggle client:load label={t("theme.toggle")} />
      <details class="site-nav__mobile">
        <summary aria-label={lang === "no" ? "Meny" : "Menu"}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </summary>
        <ul class="site-nav__mobile-list">
          {links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          <li>
            <a href={otherPath} rel="alternate" hreflang={lang === "en" ? "no" : "en"}>
              {t("lang.switch")}
            </a>
          </li>
        </ul>
      </details>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
  }
  .site-nav__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav__brand img {
    border-radius: var(--radius-sm);
  }
  .site-nav__primary {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex: 1;
    min-width: 0;
  }
  .site-nav__links {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }
  .site-nav__links a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .site-nav__links a:hover {
    color: var(--fg);
  }
  .site-nav__more {
    position: relative;
  }
  .site-nav__more summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--fg-muted);
    font-size: 0.9375rem;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }
  .site-nav__more summary::-webkit-details-marker {
    display: none;
  }
  .site-nav__more summary:hover,
  .site-nav__more[open] summary {
    color: var(--fg);
  }
  .site-nav__more[open] summary svg {
    transform: rotate(180deg);
  }
  .site-nav__more summary svg {
    transition: transform var(--dur) var(--ease);
  }
  .site-nav__more-list {
    position: absolute;
    top: calc(100% + var(--space-3));
    left: 0;
    z-index: 50;
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    min-width: 10rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .site-nav__more-list a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .site-nav__more-list a:hover {
    background: var(--bg);
    color: var(--accent);
  }
  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .site-nav__lang {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
  }
  .site-nav__lang:hover {
    color: var(--fg);
    border-color: var(--accent);
  }
  .site-nav__mobile {
    display: none;
    position: relative;
  }
  .site-nav__mobile summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--fg);
    cursor: pointer;
    list-style: none;
  }
  .site-nav__mobile summary::-webkit-details-marker {
    display: none;
  }
  .site-nav__mobile summary:hover {
    border-color: var(--accent);
  }
  .site-nav__mobile[open] summary {
    border-color: var(--accent);
  }
  .site-nav__mobile-list {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    z-index: 50;
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    min-width: 12rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .site-nav__mobile-list a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .site-nav__mobile-list a:hover {
    background: var(--bg);
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .site-nav__primary {
      display: none;
    }
    .site-nav__mobile {
      display: block;
    }
    .site-nav__lang {
      display: none;
    }
  }
</style>
